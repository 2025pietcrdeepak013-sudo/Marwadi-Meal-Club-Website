# Backend Environment Variables
# For local development, copy this to .env and fill in your values
# For Render deployment, set these as environment variables in the Render dashboard

PORT=5000

# MySQL Database Configuration
# Local: Use localhost with local MySQL
# Production (Render): Use your MySQL host (e.g., remotemysql.com or Render MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=marwadi_meal_club

# MongoDB (Legacy - Optional)
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/marwadimealclub?retryWrites=true&w=majority
